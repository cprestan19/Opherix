# --- Base de datos (Neon Postgres serverless) ---
# Crear proyecto en https://console.neon.tech — usar la connection string "pooled" para runtime
# y la "direct" (unpooled) para migraciones.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/eventstaff?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/eventstaff?sslmode=require"

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="" # generar con: npx auth secret
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (registro/login con Google, auto-aprovisiona empresa nueva) ---
# Crear en https://console.cloud.google.com/apis/credentials — tipo "Web application",
# redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- ImageKit (fotos de trabajadores, documentos, selfies) ---
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# --- Firebase Cloud Messaging (push) ---
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# --- Google Maps (geolocalización de eventos y check-in) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- Email (notificaciones) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="notificaciones@opherix.app"

# --- Vercel Cron (protección de endpoints de tareas programadas) ---
CRON_SECRET=""

# --- Cloudflare Turnstile (captcha en /solicitar/[companySlug], formulario público sin cuenta) ---
# Crear en https://dash.cloudflare.com/?to=/:account/turnstile — sin estas keys, el
# formulario funciona igual pero sin captcha (se activa solo en cuanto se configuren).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
